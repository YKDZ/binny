{
  "name": "@binny/collector-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "统一采集器运行协议，以及轻量和浏览器执行环境。",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": {
      "source": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false",
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false",
    "build:fixture": "rm -rf fixture-dist && tsc -p tsconfig.fixture.json --pretty false"
  },
  "dependencies": {
    "@binny/api": "workspace:*",
    "@binny/collector-sdk": "workspace:*",
    "@binny/contracts": "workspace:*",
    "playwright-core": "1.64.1",
    "ws": "8.18.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@binny/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "8.18.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "24.21.0"
  }
}
