{
  "name": "@binny/core",
  "version": "0.0.0",
  "private": true,
  "description": "归档、查询、删除、运行管理及资源存储实现。",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": {
      "source": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "test:unit": "node --conditions=source --test --test-reporter=spec 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false",
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false"
  },
  "dependencies": {
    "@binny/contracts": "workspace:*",
    "@binny/db": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cron-parser": "5.10.2",
    "drizzle-orm": "1.0.0-rc.5"
  },
  "devDependencies": {
    "@binny/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "24.21.0"
  }
}
