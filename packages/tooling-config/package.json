{
  "name": "@binny/tooling-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./base.json": "./base.json",
    "./node.json": "./node.json",
    "./oxfmt": "./oxfmt.config.ts",
    "./oxlint": "./oxlint.config.ts",
    "./bake-compose-contexts": {
      "source": "./scripts/bake-compose-contexts.ts"
    },
    "./vnc-viewer-fixture": {
      "source": "./scripts/vnc-viewer-fixture.ts"
    }
  },
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "test": "node --conditions=source --test --test-reporter=spec 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "26.13.0"
  }
}
