{
  "extends": ["//"],
  "tags": ["app", "binny:server"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [],
      "outputs": ["dist/**"],
      "cache": false,
      "tags": ["work:preparation"]
    },
    "image:build": {
      "passThroughEnv": ["BINNY_IMAGE", "BINNY_IMAGE_BUILD_CONTEXT"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.dockerignore",
        "$TURBO_ROOT$/Dockerfile",
        "$TURBO_ROOT$/docker-bake.hcl",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/apps/cli/**",
        "$TURBO_ROOT$/packages/api/**",
        "$TURBO_ROOT$/packages/contracts/**",
        "$TURBO_ROOT$/packages/core/**",
        "$TURBO_ROOT$/packages/db/**",
        "$TURBO_ROOT$/packages/server/**",
        "$TURBO_ROOT$/packages/tooling-config/**"
      ],
      "outputs": [],
      "cache": false,
      "tags": ["work:preparation"]
    },
    "format:check": {
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "lint": {
      "dependsOn": [],
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}
