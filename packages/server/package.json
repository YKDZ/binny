{
  "name": "@binny/server",
  "version": "0.0.0",
  "private": true,
  "description": "核心与 HTTP 的组装、配置及服务启动。",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": {
      "source": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false",
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false && esbuild src/human-viewer.ts --bundle --platform=browser --format=esm --target=es2022 --outfile=dist/human-viewer.js"
  },
  "dependencies": {
    "@binny/api": "workspace:*",
    "@binny/core": "workspace:*",
    "@binny/db": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@novnc/novnc": "1.7.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@binny/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "8.18.2",
    "esbuild": "0.25.12",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "24.21.0"
  }
}
