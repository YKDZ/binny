# syntax=docker/dockerfile:1.7

FROM node:26.13.0-bookworm-slim AS build

# Build the runtime from the locked workspace, without selecting an adapter.
COPY --from=ghcr.io/pnpm/pnpm:12.9.1 /opt/pnpm /opt/pnpm
RUN for bin in pnpm pn pnpx pnx; do ln -s /opt/pnpm/pnpm "/usr/local/bin/$bin"; done
WORKDIR /workspace
COPY . .
RUN pnpm install --frozen-lockfile \
  && pnpm --filter @binny/source-adapter-runtime... build \
  && pnpm --filter @binny/source-adapter-runtime --prod deploy --config.allow-unused-patches=true /runtime-deploy

FROM node:26.13.0-bookworm-slim AS browser

ADD --checksum=sha256:be1a1e161419f5c8272432f6860912550d8e29985e925913fa800493a0d0c955 https://dl.google.com/linux/chrome/deb/pool/main/g/google-chrome-stable/google-chrome-stable_156.0.8078.79-1_amd64.deb /tmp/google-chrome-stable.deb

RUN apt-get update \
  && apt-get install --yes --no-install-recommends \
    /tmp/google-chrome-stable.deb \
    fonts-freefont-ttf \
    fonts-ipafont-gothic \
    fonts-liberation \
    fonts-noto-color-emoji \
    fonts-tlwg-loma-otf \
    fonts-unifont \
    fonts-wqy-zenhei \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libfontconfig1 \
    libfreetype6 \
    libgbm1 \
    libglib2.0-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libx11-6 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    tini \
    util-linux \
    x11vnc \
    xfonts-scalable \
    xvfb \
  && rm -rf /var/lib/apt/lists/* /tmp/google-chrome-stable.deb \
    /etc/apt/sources.list.d/google-chrome.list

ENV NODE_ENV=production
ENV BINNY_RUNTIME_ENVIRONMENT=browser
ENV BINNY_BROWSER_PROFILE_REUSE=true
ENV BINNY_BROWSER_PROFILE_DIRECTORY=/var/lib/binny/browser-profile
ENV DISPLAY=:99
WORKDIR /app/binny-runtime
COPY --from=build --chown=node:node /runtime-deploy /app/binny-runtime
RUN command -v Xvfb \
  && command -v x11vnc \
  && command -v tini \
  && command -v flock \
  && mkdir -p /var/lib/binny/browser-profile \
  && chown -R node:node /var/lib/binny/browser-profile
USER node
EXPOSE 8080
ENTRYPOINT ["/usr/bin/tini", "--", "node", "/app/binny-runtime/dist/entry.js"]
