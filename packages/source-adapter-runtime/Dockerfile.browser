# syntax=docker/dockerfile:1.7
ARG BINNY_SOURCE_ADAPTER_ENTRY=fixture-dist/browser-session-source-adapter.js

FROM node:26.13.0-bookworm-slim AS browser-base

ADD --checksum=sha256:be1a1e161419f5c8272432f6860912550d8e29985e925913fa800493a0d0c955 https://dl.google.com/linux/chrome/deb/pool/main/g/google-chrome-stable/google-chrome-stable_156.0.8078.79-1_amd64.deb /tmp/google-chrome-stable.deb

RUN apt-get update \
  && apt-get install --yes --no-install-recommends \
    /tmp/google-chrome-stable.deb \
    fonts-freefont-ttf \
    fonts-ipafont-gothic \
    fonts-liberation \
    fonts-noto-color-emoji \
    fonts-tlwg-loma-otf \
    fonts-unifont \
    fonts-wqy-zenhei \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libfontconfig1 \
    libfreetype6 \
    libgbm1 \
    libglib2.0-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libx11-6 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    tini \
    util-linux \
    x11vnc \
    xfonts-scalable \
    xvfb \
  && rm -rf /var/lib/apt/lists/* /tmp/google-chrome-stable.deb \
    /etc/apt/sources.list.d/google-chrome.list

FROM browser-base AS build

# Install pnpm only in the build stage; the browser runtime needs Node alone.
COPY --from=ghcr.io/pnpm/pnpm:12.9.1 /opt/pnpm /opt/pnpm
RUN for bin in pnpm pn pnpx pnx; do ln -s /opt/pnpm/pnpm "/usr/local/bin/$bin"; done
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/cli/package.json apps/cli/
COPY packages/api/package.json packages/api/
COPY packages/source-adapter-runtime/package.json packages/source-adapter-runtime/
COPY packages/source-adapter-sdk/package.json packages/source-adapter-sdk/
COPY packages/contracts/package.json packages/contracts/
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY packages/server/package.json packages/server/
COPY packages/tooling-config/package.json packages/tooling-config/
COPY source-adapters/anthropic/package.json source-adapters/anthropic/
COPY source-adapters/deepseek/package.json source-adapters/deepseek/
COPY source-adapters/google/package.json source-adapters/google/
COPY source-adapters/huggingface/package.json source-adapters/huggingface/
COPY source-adapters/kimi/package.json source-adapters/kimi/
COPY source-adapters/linuxdo/package.json source-adapters/linuxdo/
COPY source-adapters/minimax/package.json source-adapters/minimax/
COPY source-adapters/mistral/package.json source-adapters/mistral/
COPY source-adapters/openai/package.json source-adapters/openai/
COPY source-adapters/qoder/package.json source-adapters/qoder/
COPY source-adapters/qwen/package.json source-adapters/qwen/
COPY source-adapters/rss/package.json source-adapters/rss/
RUN pnpm install --frozen-lockfile
COPY . .

ARG BINNY_SOURCE_ADAPTER_PACKAGE
ARG BINNY_SOURCE_ADAPTER_ENTRY

RUN test -n "$BINNY_SOURCE_ADAPTER_PACKAGE" \
  && test -n "$BINNY_SOURCE_ADAPTER_ENTRY" \
  && pnpm --filter "${BINNY_SOURCE_ADAPTER_PACKAGE}..." build \
  && pnpm --filter @binny/source-adapter-runtime build \
  && pnpm --filter @binny/source-adapter-runtime build:fixture \
  && pnpm --filter @binny/source-adapter-runtime --prod deploy --legacy /runtime-deploy \
  && pnpm --filter "$BINNY_SOURCE_ADAPTER_PACKAGE" --prod deploy --legacy /deploy \
  && cp -r packages/source-adapter-runtime/fixture-dist /deploy/fixture-dist \
  && test -f "/deploy/${BINNY_SOURCE_ADAPTER_ENTRY}" \
  && cp -r /runtime-deploy /deploy/binny-runtime

FROM browser-base AS browser

ARG BINNY_SOURCE_ADAPTER_ENTRY
ENV NODE_ENV=production
ENV BINNY_SOURCE_ADAPTER_ENTRY="/app/${BINNY_SOURCE_ADAPTER_ENTRY}"
ENV BINNY_RUNTIME_ENVIRONMENT=browser
ENV BINNY_BROWSER_PROFILE_REUSE=true
ENV BINNY_BROWSER_PROFILE_DIRECTORY=/var/lib/binny/browser-profile
ENV DISPLAY=:99
WORKDIR /app
COPY --from=build --chown=node:node /deploy /app
RUN command -v Xvfb \
  && command -v x11vnc \
  && command -v tini \
  && mkdir -p /var/lib/binny/browser-profile \
  && chown -R node:node /var/lib/binny/browser-profile
USER node
EXPOSE 8080
ENTRYPOINT ["/usr/bin/tini", "--", "node", "/app/binny-runtime/dist/entry.js"]
