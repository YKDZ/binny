{
  "name": "@binny/source-adapter-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "统一信源适配器运行协议，以及轻量和浏览器执行环境。",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": {
      "source": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "test": "node --conditions=source --test --test-reporter=spec 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false",
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false",
    "build:fixture": "rm -rf fixture-dist && tsc -p tsconfig.fixture.json --pretty false",
    "image:build:lightweight": "docker build --file \"${BINNY_IMAGE_BUILD_CONTEXT:-../..}/packages/source-adapter-runtime/Dockerfile.lightweight\" --tag binny/source-adapter-runtime:lightweight-v1 \"${BINNY_IMAGE_BUILD_CONTEXT:-../..}\"",
    "image:build:browser": "docker build --platform=linux/amd64 --file \"${BINNY_IMAGE_BUILD_CONTEXT:-../..}/packages/source-adapter-runtime/Dockerfile.browser\" --tag binny/source-adapter-runtime:browser-v1 \"${BINNY_IMAGE_BUILD_CONTEXT:-../..}\"",
    "image:build:protocol-fixture": "docker build --file \"${BINNY_IMAGE_BUILD_CONTEXT:-../..}/packages/source-adapter-runtime/Dockerfile.protocol-fixture\" --tag \"${BINNY_TEST_LIGHTWEIGHT_IMAGE:-binny/lightweight-fixture:local}\" \"${BINNY_IMAGE_BUILD_CONTEXT:-../..}\"",
    "image:build:configuration-fixture": "docker build --file \"${BINNY_IMAGE_BUILD_CONTEXT:-../..}/packages/source-adapter-runtime/Dockerfile.configuration-fixture\" --tag \"${BINNY_TEST_CONFIGURATION_IMAGE:-binny/configuration-fixture:local}\" \"${BINNY_IMAGE_BUILD_CONTEXT:-../..}\"",
    "image:build:manual-runs-fixture": "docker build --file \"${BINNY_IMAGE_BUILD_CONTEXT:-../..}/packages/source-adapter-runtime/Dockerfile.manual-runs-fixture\" --tag \"${BINNY_TEST_RUNNER_IMAGE:-binny/runner-fixture:local}\" \"${BINNY_IMAGE_BUILD_CONTEXT:-../..}\"",
    "image:build:schema-fixture": "docker build --file \"${BINNY_IMAGE_BUILD_CONTEXT:-../..}/packages/source-adapter-runtime/Dockerfile.schema-fixture\" --tag \"${BINNY_TEST_RUNNER_SCHEMA_IMAGE:-binny/runner-schema-fixture:local}\" \"${BINNY_IMAGE_BUILD_CONTEXT:-../..}\""
  },
  "dependencies": {
    "@binny/api": "workspace:*",
    "@binny/contracts": "workspace:*",
    "@binny/source-adapter-sdk": "workspace:*",
    "patchright-core": "1.64.2",
    "ws": "8.18.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@binny/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "8.18.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "26.13.0"
  }
}
