FROM node-bookworm-slim AS build

# Install the same native pnpm release that packageManager declares.
COPY --from=pnpm-release /opt/pnpm /opt/pnpm
RUN for bin in pnpm pn pnpx pnx; do ln -s /opt/pnpm/pnpm "/usr/local/bin/$bin"; done
WORKDIR /workspace
COPY . .
RUN --mount=type=cache,id=binny-pnpm-v12,target=/pnpm/store,sharing=locked \
  pnpm install --frozen-lockfile --store-dir=/pnpm/store \
    --filter @binny/source-adapter-runtime... --filter '!binny'
RUN pnpm --filter @binny/source-adapter-runtime... build \
  && pnpm --filter @binny/source-adapter-runtime --prod deploy --config.allow-unused-patches=true /runtime-deploy

FROM node-bookworm-slim AS lightweight

ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /runtime-deploy /app/binny-runtime
USER node
EXPOSE 8080
ENTRYPOINT ["node", "/app/binny-runtime/dist/entry.js"]
