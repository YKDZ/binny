{
  "extends": ["//"],
  "tags": ["library", "binny:db"],
  "tasks": {
    "db:generate": {
      "inputs": ["drizzle.config.ts", "src/schema.ts", "migrations/**"],
      "outputs": ["migrations/**"],
      "cache": false,
      "tags": ["work:on-demand"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [],
      "outputs": ["dist/**"],
      "cache": false,
      "tags": ["work:preparation"]
    },
    "format:check": {
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "lint": {
      "dependsOn": [],
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}
