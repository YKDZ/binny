# 部署三个镜像时使用同一个已提交的源码版本标签。
BINNY_IMAGE=binny/server:local
BINNY_RSS_IMAGE=binny/rss:local
BINNY_LINUXDO_IMAGE=binny/linuxdo:local

BINNY_LISTEN_ADDRESS=0.0.0.0
BINNY_PORT=5030

# 必须在宿主机预先创建；所有路径都是宿主机路径。
BINNY_APPDATA_DIRECTORY=/mnt/user/appdata/binny
BINNY_ARCHIVE_DIRECTORY=/mnt/user/binny/resources

# 使用 openssl rand -hex 24 生成，填入部署目录的 .env。
BINNY_POSTGRES_PASSWORD=

BINNY_RSS_BIN_ID=rss
BINNY_LINUXDO_BIN_ID=linuxdo
BINNY_BROWSER_CAPACITY_LIMIT=1
