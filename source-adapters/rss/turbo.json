{
  "extends": ["//"],
  "tags": ["library", "binny:source-adapter"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [],
      "outputs": ["dist/**"],
      "cache": false,
      "tags": ["work:preparation"]
    },
    "image:build": {
      "dependsOn": ["@binny/source-adapter-runtime#image:build:lightweight"],
      "passThroughEnv": ["BINNY_RSS_IMAGE", "BINNY_IMAGE_BUILD_CONTEXT"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../.dockerignore",
        "../../packages/api/src/**",
        "../../packages/contracts/src/**",
        "../../packages/source-adapter-sdk/src/**",
        "../../packages/source-adapter-runtime/Dockerfile.lightweight",
        "../../packages/source-adapter-runtime/src/**",
        "../../source-adapters/rss/Dockerfile",
        "../../source-adapters/rss/package.json",
        "../../source-adapters/rss/src/**",
        "../../source-adapters/rss/tsconfig.build.json",
        "../../docker-bake.hcl",
        "../../package.json",
        "../../pnpm-lock.yaml",
        "../../pnpm-workspace.yaml",
        "../../patches/**"
      ],
      "outputs": [],
      "cache": false,
      "tags": ["work:preparation"]
    },
    "format:check": {
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "lint": {
      "dependsOn": [],
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}
