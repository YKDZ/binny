{
  "name": "@binny/source-adapter-browser-session-fixture",
  "version": "0.0.0",
  "private": true,
  "description": "受控浏览器会话生命周期验收用信源适配器。",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false",
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false",
    "image:build": "cd \"${BINNY_IMAGE_BUILD_CONTEXT:-../..}\" && docker buildx bake --load --file package.json --file docker-bake.hcl adapter-browser-session-fixture"
  },
  "dependencies": {
    "@binny/source-adapter-sdk": "workspace:*",
    "patchright-core": "1.64.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@binny/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "26.13.0"
  }
}
