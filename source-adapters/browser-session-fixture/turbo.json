{
  "extends": ["//"],
  "tags": ["library", "binny:source-adapter"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [],
      "outputs": ["dist/**"],
      "cache": false,
      "tags": ["work:preparation"]
    },
    "image:build": {
      "dependsOn": ["@binny/source-adapter-runtime#image:build:browser"],
      "passThroughEnv": [
        "BINNY_IMAGE_BUILD_CONTEXT",
        "BINNY_TEST_BROWSER_IMAGE"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.dockerignore",
        "$TURBO_ROOT$/docker-bake.hcl",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/packages/api/**",
        "$TURBO_ROOT$/packages/contracts/**",
        "$TURBO_ROOT$/packages/source-adapter-sdk/**",
        "$TURBO_ROOT$/packages/tooling-config/**",
        "$TURBO_ROOT$/packages/source-adapter-runtime/Dockerfile.browser"
      ],
      "outputs": [],
      "cache": false,
      "tags": ["work:preparation"]
    },
    "format:check": {
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "lint": {
      "dependsOn": [],
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}
