{
  "name": "@binny/source-adapter-linuxdo",
  "version": "0.0.0",
  "private": true,
  "description": "Linux.do 内容发现、主题与回复及媒体采集。",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": {
      "source": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./acceptance": {
      "source": "./scripts/acceptance-journey.ts"
    }
  },
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false",
    "test": "node --conditions=source --test",
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false",
    "test:acceptance": "node --conditions=source scripts/acceptance.ts"
  },
  "dependencies": {
    "@binny/source-adapter-sdk": "workspace:*",
    "patchright-core": "1.64.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@binny/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "26.13.0"
  }
}
