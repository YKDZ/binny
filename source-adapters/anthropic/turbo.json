{
  "extends": ["//"],
  "tags": ["library", "binny:source-adapter"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [],
      "outputs": ["dist/**"],
      "cache": false,
      "tags": ["work:preparation"]
    },
    "format:check": {
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "lint": {
      "dependsOn": [],
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "image:build": {
      "dependsOn": ["@binny/source-adapter-runtime#image:build:lightweight"],
      "passThroughEnv": [
        "BINNY_ARTICLE_ANTHROPIC_IMAGE",
        "BINNY_IMAGE_BUILD_CONTEXT"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../**",
        "../../.dockerignore",
        "../../.gitignore",
        "!../../.git/**",
        "!../../.agents/**",
        "!../../.codex/**",
        "!../../.scratch/**",
        "!../../.template/**",
        "!../../.changeset/**",
        "!../../.github/**",
        "!../../.vscode/**",
        "!../../docs/**",
        "!../../AGENTS.md",
        "!../../**/AGENTS.md",
        "!../../GLOSSARY*.md",
        "!../../**/GLOSSARY*.md",
        "!../../node_modules/**",
        "!../../**/node_modules/**",
        "!../../**/dist/**",
        "!../../**/fixture-dist/**",
        "!../../coverage/**",
        "!../../**/coverage/**",
        "!../../*.log",
        "!../../**/*.log",
        "!../../.turbo/**",
        "!../../.env",
        "!../../.env.*"
      ],
      "outputs": [],
      "cache": false,
      "tags": ["work:preparation"]
    }
  }
}
