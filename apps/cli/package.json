{
  "name": "@ykdz/binny",
  "version": "0.1.0",
  "description": "Binny 归档、查询与垃圾桶管理命令行工具。",
  "homepage": "https://github.com/YKDZ/binny",
  "bugs": {
    "url": "https://github.com/YKDZ/binny/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YKDZ/binny.git",
    "directory": "apps/cli"
  },
  "bin": {
    "binny": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --noEmit --pretty false && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node24 --external:@ykdz/cli-contract --external:@ykdz/cli-contract/* --external:zod --outfile=dist/cli.js",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "postbuild": "node -e \"if (process.platform !== 'win32') require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "test": "node --conditions=source --test --test-reporter=spec 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false"
  },
  "dependencies": {
    "@ykdz/cli-contract": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@binny/api": "workspace:*",
    "@binny/contracts": "workspace:*",
    "@binny/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "0.25.12",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
