{
  "tasks": {
    "//#boundaries": {
      "tags": ["quality:light"]
    },
    "//#check": {
      "tags": ["quality:entry"]
    },
    "//#check:full": {
      "tags": ["quality:entry"]
    },
    "//#check:heavy": {
      "tags": ["quality:entry"]
    },
    "//#fix": {
      "tags": ["work:repair"]
    },
    "//#format:check": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#format:write": {
      "cache": false,
      "dependsOn": ["//#lint:fix"],
      "tags": ["work:repair"]
    },
    "//#lint": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#lint:fix": {
      "cache": false,
      "tags": ["work:repair"]
    },
    "//#typecheck": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#test:binny:e2e": {
      "dependsOn": [
        "@binny/api#build",
        "@binny/binny#build",
        "@binny/collector-sdk#build",
        "@binny/collector-rss#build"
      ],
      "passThroughEnv": [
        "BINNY_E2E_HOST",
        "BINNY_E2E_BASELINE_IMAGE",
        "BINNY_E2E_BASELINE_IMAGE_ID",
        "BINNY_E2E_CAPACITY_PROFILE",
        "BINNY_E2E_CAPACITY_PHASE",
        "BINNY_E2E_SUBNET",
        "BINNY_E2E_RUNTIME_SUBNET",
        "BINNY_E2E_CONNECTIONS_SUBNET",
        "BINNY_E2E_BROWSER_SUBNET",
        "BINNY_E2E_LINUXDO_SUBNET"
      ],
      "inputs": [
        "compose.acceptance.yaml",
        "Dockerfile",
        "scripts/binny-isolated-consumer.ts",
        "scripts/binny-e2e.ts",
        "scripts/binny-e2e-heartbeat-proxy.ts",
        "scripts/binny-image-update-context.ts",
        "scripts/binny-e2e-linuxdo-journey.ts",
        "scripts/binny-e2e-rss-source.ts",
        "pnpm-lock.yaml",
        "packages/api/package.json",
        "packages/api/src/**",
        "packages/api/scripts/**",
        "packages/api/test-consumer/**",
        "packages/binny/src/**",
        "packages/collector-sdk/scripts/**",
        "packages/collector-sdk/src/**",
        "packages/collector-runtime/Dockerfile.lightweight",
        "packages/collector-runtime/src/**",
        "packages/collector-runtime/test/fixtures/**",
        "collectors/rss/package.json",
        "collectors/rss/src/**",
        "packages/contracts/src/**",
        "packages/core/package.json",
        "packages/core/src/**",
        "packages/db/**",
        "packages/server/package.json",
        "packages/server/src/**"
      ],
      "outputs": [],
      "cache": false,
      "tags": ["quality:heavy"]
    },
    "//#test:linuxdo-collector": {
      "passThroughEnv": [
        "BINNY_DISCOVERY_PUBLISHED_HOST",
        "BINNY_DISCOVERY_API_SUBNET",
        "BINNY_DISCOVERY_RUNTIME_SUBNET",
        "BINNY_DISCOVERY_CONNECTIONS_SUBNET",
        "BINNY_DISCOVERY_BROWSER_SUBNET"
      ],
      "inputs": [
        "compose.acceptance.yaml",
        "Dockerfile",
        "packages/collector-runtime/Dockerfile.browser",
        "scripts/test-linuxdo-collector.ts",
        "scripts/binny-e2e-linuxdo-source.ts",
        "scripts/binny-e2e-linuxdo-journey.ts",
        "packages/api/src/**",
        "packages/binny/src/**",
        "packages/collector-runtime/package.json",
        "packages/collector-runtime/src/**",
        "packages/collector-sdk/src/**",
        "packages/contracts/src/**",
        "packages/core/package.json",
        "packages/core/src/**",
        "packages/db/**",
        "packages/server/package.json",
        "packages/server/src/**",
        "packages/tooling-config/**",
        "collectors/linuxdo/package.json",
        "collectors/linuxdo/src/**",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "package.json"
      ],
      "outputs": [],
      "cache": false,
      "tags": ["quality:heavy"]
    },
    "//#publication:pack": {
      "tags": ["work:release"],
      "cache": false
    },
    "//#publication:publish": {
      "tags": ["work:release"],
      "cache": false
    },
    "//#test:lightweight-image": {
      "inputs": [
        "scripts/test-lightweight-image.ts",
        ".dockerignore",
        "packages/collector-runtime/Dockerfile.lightweight",
        "packages/collector-runtime/**",
        "packages/collector-sdk/**",
        "packages/api/**",
        "packages/contracts/**",
        "packages/core/package.json",
        "packages/db/**",
        "packages/server/package.json",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ],
      "outputs": [],
      "cache": false,
      "tags": ["quality:heavy"]
    },
    "//#test:browser-lifecycle": {
      "passThroughEnv": [
        "BINNY_BROWSER_PUBLISHED_HOST",
        "BINNY_CAPACITY_SUBNET"
      ],
      "inputs": [
        "compose.acceptance.yaml",
        "Dockerfile",
        "packages/collector-runtime/Dockerfile.browser",
        "scripts/binny-image-update-context.ts",
        "scripts/test-browser-lifecycle.ts",
        "packages/api/src/**",
        "packages/binny/src/**",
        "packages/collector-runtime/package.json",
        "packages/collector-runtime/src/**",
        "packages/collector-runtime/test/fixtures/browser-session-collector.ts",
        "packages/collector-sdk/src/**",
        "packages/contracts/src/**",
        "packages/core/package.json",
        "packages/core/src/**",
        "packages/db/**",
        "packages/server/package.json",
        "packages/server/src/**",
        "packages/tooling-config/**",
        "scripts/browser-session-source.ts",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ],
      "outputs": [],
      "cache": false,
      "tags": ["quality:heavy"]
    },
    "//#test:runtime-connections": {
      "dependsOn": ["@binny/binny#build"],
      "passThroughEnv": [
        "BINNY_RUNTIME_PUBLISHED_HOST",
        "BINNY_RUNTIME_SUBNET"
      ],
      "inputs": [
        "compose.acceptance.yaml",
        "Dockerfile",
        "packages/collector-runtime/Dockerfile.lightweight",
        "scripts/test-runtime-connections.ts",
        "packages/api/src/**",
        "packages/binny/src/**",
        "packages/collector-runtime/src/**",
        "packages/collector-runtime/test/fixtures/**",
        "packages/contracts/src/**",
        "packages/core/src/**",
        "packages/core/package.json",
        "packages/db/**",
        "packages/server/package.json",
        "packages/server/src/**"
      ],
      "outputs": [],
      "cache": false,
      "tags": ["quality:heavy"]
    }
  },
  "boundaries": {
    "tags": {
      "app": {
        "dependencies": {
          "allow": ["app", "library"]
        }
      },
      "library": {
        "dependencies": {
          "allow": ["library"]
        }
      },
      "binny:tooling": {
        "dependencies": {
          "allow": []
        }
      },
      "binny:contracts": {
        "dependencies": {
          "allow": ["binny:tooling"]
        }
      },
      "binny:core": {
        "dependencies": {
          "allow": ["binny:contracts", "binny:db", "binny:tooling"]
        }
      },
      "binny:db": {
        "dependencies": {
          "allow": ["binny:tooling"]
        }
      },
      "binny:api": {
        "dependencies": {
          "allow": ["binny:contracts", "binny:tooling"]
        }
      },
      "binny:server": {
        "dependencies": {
          "allow": [
            "binny:core",
            "binny:api",
            "binny:contracts",
            "binny:db",
            "binny:tooling"
          ]
        }
      },
      "binny:cli": {
        "dependencies": {
          "allow": ["binny:api", "binny:contracts", "binny:tooling"]
        }
      },
      "binny:collector-sdk": {
        "dependencies": {
          "allow": ["binny:api", "binny:contracts", "binny:tooling"]
        }
      },
      "binny:collector-runtime": {
        "dependencies": {
          "allow": [
            "binny:collector-sdk",
            "binny:api",
            "binny:contracts",
            "binny:tooling"
          ]
        }
      },
      "binny:collector": {
        "dependencies": {
          "allow": [
            "binny:collector-sdk",
            "binny:api",
            "binny:contracts",
            "binny:tooling"
          ]
        }
      }
    }
  },
  "globalDependencies": [
    "packages/tooling-config/oxfmt.config.ts",
    "packages/tooling-config/oxlint.config.ts"
  ]
}
