{
  "tasks": {
    "//#boundaries": {
      "tags": ["quality:light"]
    },
    "//#check": {
      "tags": ["quality:entry"]
    },
    "//#check:full": {
      "tags": ["quality:entry"]
    },
    "//#check:heavy": {
      "tags": ["quality:entry"]
    },
    "//#fix": {
      "tags": ["work:repair"]
    },
    "//#format:check": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#format:write": {
      "cache": false,
      "dependsOn": ["//#lint:fix"],
      "tags": ["work:repair"]
    },
    "//#lint": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#lint:fix": {
      "cache": false,
      "tags": ["work:repair"]
    },
    "//#typecheck": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#test:binny:e2e": {
      "dependsOn": [
        "@binny/api#build",
        "@binny/binny#build",
        "@binny/collector-sdk#build",
        "@binny/collector-rss#build"
      ],
      "passThroughEnv": [
        "BINNY_E2E_HOST",
        "BINNY_E2E_SUBNET",
        "BINNY_E2E_RUNTIME_SUBNET"
      ],
      "inputs": [
        "compose.yaml",
        "Dockerfile",
        "scripts/binny-isolated-consumer.ts",
        "scripts/binny-e2e.ts",
        "scripts/binny-e2e-heartbeat-proxy.ts",
        "scripts/binny-e2e-rss-source.ts",
        "packages/api/package.json",
        "packages/api/src/**",
        "packages/api/scripts/**",
        "packages/api/test-consumer/**",
        "packages/binny/src/**",
        "packages/collector-sdk/scripts/**",
        "packages/collector-sdk/src/**",
        "packages/collector-runtime/Dockerfile.lightweight",
        "packages/collector-runtime/src/**",
        "packages/collector-runtime/test/fixtures/**",
        "collectors/rss/package.json",
        "collectors/rss/src/**",
        "packages/contracts/src/**",
        "packages/core/src/**",
        "packages/server/src/**"
      ],
      "outputs": [],
      "cache": false,
      "tags": ["quality:heavy"]
    },
    "//#publication:pack": {
      "tags": ["work:release"],
      "cache": false
    },
    "//#publication:publish": {
      "tags": ["work:release"],
      "cache": false
    },
    "//#test:lightweight-image": {
      "inputs": [
        "scripts/test-lightweight-image.ts",
        ".dockerignore",
        "packages/collector-runtime/Dockerfile.lightweight",
        "packages/collector-runtime/**",
        "packages/collector-sdk/**",
        "packages/api/**",
        "packages/contracts/**",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ],
      "outputs": [],
      "cache": false,
      "tags": ["quality:heavy"]
    },
    "//#test:runtime-connections": {
      "dependsOn": ["@binny/binny#build"],
      "passThroughEnv": ["BINNY14_PUBLISHED_HOST", "BINNY14_SUBNET"],
      "inputs": [
        "compose.yaml",
        "Dockerfile",
        "packages/collector-runtime/Dockerfile.lightweight",
        "scripts/test-runtime-connections.ts",
        "packages/api/src/**",
        "packages/binny/src/**",
        "packages/collector-runtime/src/**",
        "packages/collector-runtime/test/fixtures/**",
        "packages/contracts/src/**",
        "packages/core/src/**",
        "packages/server/src/**"
      ],
      "outputs": [],
      "cache": false,
      "tags": ["quality:heavy"]
    }
  },
  "boundaries": {
    "tags": {
      "app": {
        "dependencies": {
          "allow": ["app", "library"]
        }
      },
      "library": {
        "dependencies": {
          "allow": ["library"]
        }
      },
      "binny:tooling": {
        "dependencies": {
          "allow": []
        }
      },
      "binny:contracts": {
        "dependencies": {
          "allow": ["binny:tooling"]
        }
      },
      "binny:core": {
        "dependencies": {
          "allow": ["binny:contracts", "binny:tooling"]
        }
      },
      "binny:api": {
        "dependencies": {
          "allow": ["binny:contracts", "binny:tooling"]
        }
      },
      "binny:server": {
        "dependencies": {
          "allow": [
            "binny:core",
            "binny:api",
            "binny:contracts",
            "binny:tooling"
          ]
        }
      },
      "binny:cli": {
        "dependencies": {
          "allow": ["binny:api", "binny:contracts", "binny:tooling"]
        }
      },
      "binny:collector-sdk": {
        "dependencies": {
          "allow": ["binny:api", "binny:contracts", "binny:tooling"]
        }
      },
      "binny:collector-runtime": {
        "dependencies": {
          "allow": [
            "binny:collector-sdk",
            "binny:api",
            "binny:contracts",
            "binny:tooling"
          ]
        }
      },
      "binny:collector": {
        "dependencies": {
          "allow": [
            "binny:collector-sdk",
            "binny:api",
            "binny:contracts",
            "binny:tooling"
          ]
        }
      }
    }
  },
  "globalDependencies": [
    "packages/tooling-config/oxfmt.config.ts",
    "packages/tooling-config/oxlint.config.ts"
  ]
}
